{
  "name": "@life-ai-tools/opencode-claude",
  "version": "1.6.2",
  "description": "OpenCode plugin + AI SDK provider for Claude Max/Pro subscription — OAuth login, streaming, tool use via claude-code-sdk",
  "type": "module",
  "exports": {
    ".": "./dist/provider.js",
    "./server": "./dist/index.js"
  },
  "main": "./dist/provider.js",
  "files": [
    "dist/",
    "plugin-v2.ts",
    "provider.ts",
    "v2-model.ts",
    "v2-register.ts"
  ],
  "scripts": {
    "build": "bun build provider.ts --target=bun --outfile=dist/provider.js && bun build index.ts --target=bun --outfile=dist/index.js",
    "test": "bun test"
  },
  "dependencies": {
    "@life-ai-tools/claude-code-sdk": "^0.14.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude",
    "anthropic",
    "claude-max",
    "oauth",
    "ai-sdk",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LifeAITools/opencode-claude-toolkit"
  },
  "license": "MIT",
  "engines": {
    "opencode": ">=1.0.0"
  }
}
